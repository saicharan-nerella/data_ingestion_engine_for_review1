# Copy to .env and fill values. Never commit .env.
PIPELINE_CONFIG=config/pipeline_config.yaml

# Database source
DB_HOST=localhost
DB_PORT=5432
DB_NAME=source_db
DB_USER=
DB_PASSWORD=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Snowflake target
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# AWS (S3 / Kinesis / CloudWatch)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Alerts
SLACK_WEBHOOK_URL=
PAGERDUTY_SERVICE_KEY=
SMTP_PASSWORD=
DATADOG_API_KEY=
